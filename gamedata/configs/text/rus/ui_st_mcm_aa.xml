<?xml version="1.0" encoding="windows-1251"?>
<string_table>
  <string id="ui_mcm_menu_aa">
    <text>AlifeAmbience</text>
  </string>
  <string id="ui_mcm_aa_desc">
    <text>Тёмный эмбиент поверх базового саундскейпа. Все параметры на 1.0 — без изменений; сдвиньте любой, и рантайм-слой перехватит динамический эмбиент, чтобы применить настройку.</text>
  </string>
  <string id="ui_mcm_aa_hdr_moods">
    <text>Громкость акцентов по настроению</text>
  </string>
  <string id="ui_mcm_aa_vol_global">
    <text>Громкость акцентов (все)</text>
  </string>
  <string id="ui_mcm_aa_vol_global_desc">
    <text>Множитель громкости для каждого одиночного динамического звука.</text>
  </string>
  <string id="ui_mcm_aa_vol_dread">
    <text>Громкость ужаса</text>
  </string>
  <string id="ui_mcm_aa_vol_dread_desc">
    <text>Громкость акцентов ужаса: крики, шорохи, рёв мутантов, тёмный эмбиент.</text>
  </string>
  <string id="ui_mcm_aa_vol_underground">
    <text>Громкость подземелья</text>
  </string>
  <string id="ui_mcm_aa_vol_underground_desc">
    <text>Громкость акцентов туннелей и лабораторий: крысы, металл, капли, механизмы.</text>
  </string>
  <string id="ui_mcm_aa_vol_weather">
    <text>Громкость погоды</text>
  </string>
  <string id="ui_mcm_aa_vol_weather_desc">
    <text>Громкость акцентов грозы, дождя и ветра.</text>
  </string>
  <string id="ui_mcm_aa_vol_human">
    <text>Громкость людей</text>
  </string>
  <string id="ui_mcm_aa_vol_human_desc">
    <text>Громкость далёких выстрелов и дронов.</text>
  </string>
  <string id="ui_mcm_aa_vol_animal">
    <text>Громкость животных</text>
  </string>
  <string id="ui_mcm_aa_vol_animal_desc">
    <text>Громкость ворон, собак и сов.</text>
  </string>
  <string id="ui_mcm_aa_hdr_feel">
    <text>Частота и расстояние</text>
  </string>
  <string id="ui_mcm_aa_rarity">
    <text>Редкость</text>
  </string>
  <string id="ui_mcm_aa_rarity_desc">
    <text>Пауза между акцентами. Выше — реже.</text>
  </string>
  <string id="ui_mcm_aa_distance">
    <text>Расстояние</text>
  </string>
  <string id="ui_mcm_aa_distance_desc">
    <text>Как далеко возникают акценты. Выше — дальше и тише.</text>
  </string>
  <string id="ui_mcm_aa_texture_volume">
    <text>Громкость фоновой текстуры</text>
  </string>
  <string id="ui_mcm_aa_texture_volume_desc">
    <text>Громкость непрерывного зацикленного фона под всем остальным.</text>
  </string>
  <string id="ui_mcm_aa_hdr_dev">
    <text>Разработка</text>
  </string>
  <string id="ui_mcm_aa_log_level">
    <text>Трассировка эмбиента</text>
  </string>
  <string id="ui_mcm_aa_log_level_desc">
    <text>Записывает каждое воспроизведение эмбиента в alifeambience.log: канал, настроение, файл, расстояние, громкость и контекст. Для диагностики саундскейпа.</text>
  </string>
  <string id="aa_log_level_lst_off">
    <text>Выкл.</text>
  </string>
  <string id="aa_log_level_lst_info">
    <text>Инфо</text>
  </string>
  <string id="aa_log_level_lst_debug">
    <text>Трасса каждого воспроизведения</text>
  </string>
  <string id="aa_log_level_lst_trace">
    <text>Трасса (подробно)</text>
  </string>
  <string id="ui_mcm_aa_log_flush">
    <text>Сброс лога построчно</text>
  </string>
  <string id="ui_mcm_aa_log_flush_desc">
    <text>Записывать каждую строку немедленно. Медленнее; только при поиске вылета.</text>
  </string>
  <string id="ui_mcm_menu_atmosphere">
    <text>Атмосфера</text>
  </string>
  <string id="ui_mcm_menu_diegetic">
    <text>Звуки мира</text>
  </string>
  <string id="ui_mcm_aa_dia_desc">
    <text>Звуки, которые персонажи слышат в мире: радио на базах, мегафоны, инструменты у костра. Любой регулятор на 1.0 оставляет источник таким, как в базовой игре.</text>
  </string>
  <string id="ui_mcm_aa_dia_master">
    <text>Общая громкость</text>
  </string>
  <string id="ui_mcm_aa_dia_master_desc">
    <text>Множитель громкости для всех источников в мире ниже.</text>
  </string>
  <string id="ui_mcm_aa_hdr_dia_radio">
    <text>Радио</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_enabled">
    <text>Включить радио</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_enabled_desc">
    <text>Радио на базах и у костров. Выкл. заглушает их.</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_vol">
    <text>Громкость радио</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_vol_desc">
    <text>Громкость радио в мире.</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_freq">
    <text>Пауза радио</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_freq_desc">
    <text>Ожидание между треками радио. Больше — дольше тишина.</text>
  </string>
  <string id="ui_mcm_aa_hdr_dia_megaphone">
    <text>Мегафоны</text>
  </string>
  <string id="ui_mcm_aa_dia_megaphone_enabled">
    <text>Включить мегафоны</text>
  </string>
  <string id="ui_mcm_aa_dia_megaphone_enabled_desc">
    <text>Громкоговорители. Выкл. заглушает их.</text>
  </string>
  <string id="ui_mcm_aa_dia_megaphone_vol">
    <text>Громкость мегафона</text>
  </string>
  <string id="ui_mcm_aa_dia_megaphone_vol_desc">
    <text>Громкость объявлений через мегафон.</text>
  </string>
  <string id="ui_mcm_aa_dia_megaphone_freq">
    <text>Пауза мегафона</text>
  </string>
  <string id="ui_mcm_aa_dia_megaphone_freq_desc">
    <text>Ожидание между объявлениями. Больше — дольше тишина.</text>
  </string>
  <string id="ui_mcm_aa_hdr_dia_guitar">
    <text>Гитара</text>
  </string>
  <string id="ui_mcm_aa_dia_guitar_enabled">
    <text>Включить гитару</text>
  </string>
  <string id="ui_mcm_aa_dia_guitar_enabled_desc">
    <text>Гитара у костра. Нужен мод анимации гитары; без него не работает.</text>
  </string>
  <string id="ui_mcm_aa_dia_guitar_vol">
    <text>Громкость гитары</text>
  </string>
  <string id="ui_mcm_aa_dia_guitar_vol_desc">
    <text>Громкость гитары у костра.</text>
  </string>
  <string id="ui_mcm_aa_hdr_dia_harmonica">
    <text>Губная гармошка</text>
  </string>
  <string id="ui_mcm_aa_dia_harmonica_enabled">
    <text>Включить гармошку</text>
  </string>
  <string id="ui_mcm_aa_dia_harmonica_enabled_desc">
    <text>Губная гармошка у костра. Нужен мод анимации; без него не работает.</text>
  </string>
  <string id="ui_mcm_aa_dia_harmonica_vol">
    <text>Громкость гармошки</text>
  </string>
  <string id="ui_mcm_aa_dia_harmonica_vol_desc">
    <text>Громкость губной гармошки у костра.</text>
  </string>
</string_table>
