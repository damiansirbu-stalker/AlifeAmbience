  </string>
  <string id="ui_mcm_aa_dia_megaphone_freq_desc">
    <text>Ожидание между объявлениями. Больше — дольше тишина.</text>
  </string>
  <string id="ui_mcm_aa_hdr_dia_guitar">
    <text>Гитара</text>
  </string>
  <string id="ui_mcm_aa_dia_guitar_enabled">
