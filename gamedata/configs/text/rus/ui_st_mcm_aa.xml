<?xml version="1.0" encoding="windows-1251"?>
<string_table>
  <string id="ui_mcm_menu_aa">
    <text>AlifeAmbience</text>
  </string>
  <string id="ui_mcm_aa_desc">
    <text>Тёмный эмбиент поверх базового саундскейпа. Все параметры на 1.0 — без изменений; сдвиньте любой, и рантайм-слой перехватит динамический эмбиент, чтобы применить настройку.</text>
  </string>
  <string id="ui_mcm_aa_hdr_layers">
    <text>Громкость акцентов по слою</text>
  </string>
  <string id="ui_mcm_aa_vol_global">
    <text>Громкость акцентов (все)</text>
  </string>
  <string id="ui_mcm_aa_vol_global_desc">
    <text>Множитель громкости для каждого одиночного динамического звука.</text>
  </string>
  <string id="ui_mcm_aa_vol_spooks">
    <text>Громкость призраков</text>
  </string>
  <string id="ui_mcm_aa_vol_spooks_desc">
    <text>Громкость акцентов призраков: шёпот, присутствие, шаги.</text>
  </string>
  <string id="ui_mcm_aa_vol_screams">
    <text>Громкость криков</text>
  </string>
  <string id="ui_mcm_aa_vol_screams_desc">
    <text>Громкость далёких человеческих и звериных криков.</text>
  </string>
  <string id="ui_mcm_aa_vol_mutants">
    <text>Громкость мутантов</text>
  </string>
  <string id="ui_mcm_aa_vol_mutants_desc">
    <text>Громкость далёких зовов и рыков мутантов.</text>
  </string>
  <string id="ui_mcm_aa_vol_ambience">
    <text>Громкость тёмного эмбиента</text>
  </string>
  <string id="ui_mcm_aa_vol_ambience_desc">
    <text>Громкость низких гнетущих подложек и гулов.</text>
  </string>
  <string id="ui_mcm_aa_vol_machines">
    <text>Громкость машин</text>
  </string>
  <string id="ui_mcm_aa_vol_machines_desc">
    <text>Громкость далёкой стрельбы, дронов, промышленности и радио.</text>
  </string>
  <string id="ui_mcm_aa_vol_forest">
    <text>Громкость леса</text>
  </string>
  <string id="ui_mcm_aa_vol_forest_desc">
    <text>Громкость треска веток, шелеста листвы и лесных вздрагиваний.</text>
  </string>
  <string id="ui_mcm_aa_vol_storm">
    <text>Громкость грозы</text>
  </string>
  <string id="ui_mcm_aa_vol_storm_desc">
    <text>Громкость грома и грозовых акцентов.</text>
  </string>
  <string id="ui_mcm_aa_vol_wind">
    <text>Громкость ветра</text>
  </string>
  <string id="ui_mcm_aa_vol_wind_desc">
    <text>Громкость ветра и крадущихся порывов.</text>
  </string>
  <string id="ui_mcm_aa_vol_rain">
    <text>Громкость дождя</text>
  </string>
  <string id="ui_mcm_aa_vol_rain_desc">
    <text>Громкость дождевых акцентов.</text>
  </string>
  <string id="ui_mcm_aa_vol_wildlife">
    <text>Громкость живности</text>
  </string>
  <string id="ui_mcm_aa_vol_wildlife_desc">
    <text>Громкость акцентов ворон, собак и сов.</text>
  </string>
  <string id="ui_mcm_aa_vol_underground">
    <text>Громкость подземелья</text>
  </string>
  <string id="ui_mcm_aa_vol_underground_desc">
    <text>Громкость акцентов туннелей и лабораторий: крысы, металл, капли, механизмы.</text>
  </string>
  <string id="ui_mcm_aa_hdr_feel">
    <text>Частота и расстояние</text>
  </string>
  <string id="ui_mcm_aa_rarity">
    <text>Редкость</text>
  </string>
  <string id="ui_mcm_aa_rarity_desc">
    <text>Пауза между акцентами. Выше — реже.</text>
  </string>
  <string id="ui_mcm_aa_distance">
    <text>Расстояние</text>
  </string>
  <string id="ui_mcm_aa_distance_desc">
    <text>Как далеко возникают акценты. Выше — дальше и тише.</text>
  </string>
  <string id="ui_mcm_aa_texture_volume">
    <text>Громкость фоновой текстуры</text>
  </string>
  <string id="ui_mcm_aa_texture_volume_desc">
    <text>Громкость непрерывного зацикленного фона под всем остальным.</text>
  </string>
  <string id="ui_mcm_aa_hdr_dev">
    <text>Разработка</text>
  </string>
  <string id="ui_mcm_aa_log_level">
    <text>Трассировка эмбиента</text>
  </string>
  <string id="ui_mcm_aa_log_level_desc">
    <text>Записывает каждое воспроизведение эмбиента в alifeambience.log: канал, настроение, файл, расстояние, громкость и контекст. Для диагностики саундскейпа.</text>
  </string>
  <string id="aa_atmosphere_log_level_lst_off">
    <text>Выкл.</text>
  </string>
  <string id="aa_atmosphere_log_level_lst_info">
    <text>Инфо</text>
  </string>
  <string id="aa_atmosphere_log_level_lst_debug">
    <text>Трасса каждого воспроизведения</text>
  </string>
  <string id="aa_atmosphere_log_level_lst_trace">
    <text>Трасса (подробно)</text>
  </string>
  <string id="ui_mcm_aa_log_flush">
    <text>Сброс лога построчно</text>
  </string>
  <string id="ui_mcm_aa_log_flush_desc">
    <text>Записывать каждую строку немедленно. Медленнее; только при поиске вылета.</text>
  </string>
  <string id="ui_mcm_menu_atmosphere">
    <text>Атмосфера</text>
  </string>
  <string id="ui_mcm_menu_diegetic">
    <text>Звуки мира</text>
  </string>
  <string id="ui_mcm_aa_dia_desc">
    <text>Звуки, которые персонажи слышат в мире: радио на базах, мегафоны, инструменты у костра. Любой регулятор на 1.0 оставляет источник таким, как в базовой игре.</text>
  </string>
  <string id="ui_mcm_aa_dia_master">
    <text>Общая громкость</text>
  </string>
  <string id="ui_mcm_aa_dia_master_desc">
    <text>Множитель громкости для всех источников в мире ниже.</text>
  </string>
  <string id="ui_mcm_aa_hdr_dia_radio">
    <text>Радио</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_enabled">
    <text>Включить радио</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_enabled_desc">
    <text>Радио на базах и у костров. Выкл. заглушает их.</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_vol">
    <text>Громкость радио</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_vol_desc">
    <text>Громкость радио в мире.</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_freq">
    <text>Пауза радио</text>
  </string>
