<?xml version="1.0" encoding="windows-1251"?>
<string_table>
  <string id="ui_mcm_menu_aa">
    <text>AlifeAmbience</text>
  </string>
  <string id="ui_mcm_menu_atmosphere">
    <text>Atmosphere</text>
  </string>
  <string id="ui_mcm_menu_diegetic">
    <text>Diegetic</text>
  </string>
  <string id="ui_mcm_menu_development">
    <text>Development</text>
  </string>
  <string id="ui_mcm_aa_desc">
    <text>Dark ambient overlay. Every control at 1.0 means no change from the base soundscape; move one and the runtime layer takes over the dynamic ambient to apply it.</text>
  </string>

  <string id="ui_mcm_aa_hdr_layers">
    <text>Accent volume by layer</text>
  </string>
  <string id="ui_mcm_aa_vol_global">
    <text>Accent volume (all)</text>
  </string>
  <string id="ui_mcm_aa_vol_global_desc">
    <text>Volume multiplier for every dynamic ambient one-shot.</text>
  </string>
  <string id="ui_mcm_aa_vol_spooks">
    <text>Spooks volume</text>
  </string>
  <string id="ui_mcm_aa_vol_spooks_desc">
    <text>Volume of spook accents: whispers, presence, footsteps.</text>
  </string>
  <string id="ui_mcm_aa_vol_screams">
    <text>Screams volume</text>
  </string>
  <string id="ui_mcm_aa_vol_screams_desc">
    <text>Volume of distant human and creature screams.</text>
  </string>
  <string id="ui_mcm_aa_vol_mutants">
    <text>Mutants volume</text>
  </string>
  <string id="ui_mcm_aa_vol_mutants_desc">
    <text>Volume of distant mutant calls and growls.</text>
  </string>
  <string id="ui_mcm_aa_vol_ambience">
    <text>Dark ambience volume</text>
  </string>
  <string id="ui_mcm_aa_vol_ambience_desc">
    <text>Volume of low dread pads and drones.</text>
  </string>
  <string id="ui_mcm_aa_vol_machines">
    <text>Machines volume</text>
  </string>
  <string id="ui_mcm_aa_vol_machines_desc">
    <text>Volume of distant gunfire, drones, industry and radio.</text>
  </string>
  <string id="ui_mcm_aa_vol_forest">
    <text>Forest volume</text>
  </string>
  <string id="ui_mcm_aa_vol_forest_desc">
    <text>Volume of branch snaps, foliage rustle and woods startle.</text>
  </string>
  <string id="ui_mcm_aa_vol_storm">
    <text>Storm volume</text>
  </string>
  <string id="ui_mcm_aa_vol_storm_desc">
    <text>Volume of thunder and storm accents.</text>
  </string>
  <string id="ui_mcm_aa_vol_wind">
    <text>Wind volume</text>
  </string>
  <string id="ui_mcm_aa_vol_wind_desc">
    <text>Volume of wind and creeping gusts.</text>
  </string>
  <string id="ui_mcm_aa_vol_rain">
    <text>Rain volume</text>
  </string>
  <string id="ui_mcm_aa_vol_rain_desc">
    <text>Volume of rain accents.</text>
  </string>
  <string id="ui_mcm_aa_vol_wildlife">
    <text>Wildlife volume</text>
  </string>
  <string id="ui_mcm_aa_vol_wildlife_desc">
    <text>Volume of crow, dog and owl accents.</text>
  </string>
  <string id="ui_mcm_aa_vol_underground">
    <text>Underground volume</text>
  </string>
  <string id="ui_mcm_aa_vol_underground_desc">
    <text>Volume of tunnel and lab accents: rats, metal, drips, machinery.</text>
  </string>

  <string id="ui_mcm_aa_hdr_feel">
    <text>Frequency and distance</text>
  </string>
  <string id="ui_mcm_aa_rarity">
    <text>Rarity</text>
  </string>
  <string id="ui_mcm_aa_rarity_desc">
    <text>Wait between accents. Higher plays them less often.</text>
  </string>
  <string id="ui_mcm_aa_distance">
    <text>Distance</text>
  </string>
  <string id="ui_mcm_aa_distance_desc">
    <text>How far accents spawn. Higher is farther and quieter.</text>
  </string>
  <string id="ui_mcm_aa_texture_volume">
    <text>Texture bed volume</text>
  </string>
  <string id="ui_mcm_aa_texture_volume_desc">
    <text>Loudness of the continuous looped bed under everything.</text>
  </string>
  <string id="ui_mcm_aa_variety">
    <text>No-repeat variety</text>
  </string>
  <string id="ui_mcm_aa_variety_desc">
    <text>Never replay a channel's recent sound, so its full variety is heard instead of the same few on repeat. Off falls back to the base random pick.</text>
  </string>

  <string id="ui_mcm_aa_development_desc">
    <text>Tracing for diagnosing the soundscape. No effect on gameplay.</text>
  </string>
  <string id="ui_mcm_aa_hdr_logging">
    <text>Logging</text>
  </string>
  <string id="ui_mcm_aa_log_level">
    <text>Ambient trace</text>
  </string>
  <string id="ui_mcm_aa_log_level_desc">
    <text>Records each ambient play to alifeambience.log with channel, mood, file, distance, volume and context. Use to diagnose the soundscape.</text>
  </string>
  <string id="aa_development_log_level_lst_off">
    <text>Off</text>
  </string>
  <string id="aa_development_log_level_lst_info">
    <text>Info</text>
  </string>
  <string id="aa_development_log_level_lst_debug">
    <text>Trace every ambient play</text>
  </string>
  <string id="aa_development_log_level_lst_trace">
    <text>Trace (verbose)</text>
  </string>
  <string id="ui_mcm_aa_log_flush">
    <text>Flush log each line</text>
  </string>
  <string id="ui_mcm_aa_log_flush_desc">
    <text>Write every line immediately. Slower; use only when hunting a crash.</text>
  </string>

  <string id="ui_mcm_aa_dia_desc">
    <text>In-world audio the characters hear: base radios, megaphones, campfire instruments. Every control at 1.0 leaves the source as the base game plays it.</text>
  </string>
  <string id="ui_mcm_aa_dia_master">
    <text>Master volume</text>
  </string>
  <string id="ui_mcm_aa_dia_master_desc">
    <text>Volume multiplier applied to every in-world source below.</text>
  </string>

  <string id="ui_mcm_aa_hdr_dia_radio">
    <text>Radios</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_enabled">
    <text>Enable radios</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_enabled_desc">
    <text>Base and campfire radios. Off mutes them.</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_vol">
    <text>Radio volume</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_vol_desc">
    <text>Volume of in-world radios.</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_freq">
    <text>Radio pause</text>
  </string>
  <string id="ui_mcm_aa_dia_radio_freq_desc">
    <text>Wait between radio tracks. Higher is longer silence.</text>
  </string>

  <string id="ui_mcm_aa_hdr_dia_megaphone">
    <text>Megaphones</text>
  </string>
  <string id="ui_mcm_aa_dia_megaphone_enabled">
    <text>Enable megaphones</text>
  </string>
  <string id="ui_mcm_aa_dia_megaphone_enabled_desc">
    <text>Loudspeaker announcers. Off mutes them.</text>
  </string>
  <string id="ui_mcm_aa_dia_megaphone_vol">
    <text>Megaphone volume</text>
  </string>
  <string id="ui_mcm_aa_dia_megaphone_vol_desc">
    <text>Volume of megaphone announcers.</text>
  </string>
  <string id="ui_mcm_aa_dia_megaphone_freq">
    <text>Megaphone pause</text>
  </string>
  <string id="ui_mcm_aa_dia_megaphone_freq_desc">
    <text>Wait between announcements. Higher is longer silence.</text>
  </string>

  <string id="ui_mcm_aa_hdr_dia_guitar">
    <text>Guitar</text>
  </string>
  <string id="ui_mcm_aa_dia_guitar_enabled">
    <text>Enable guitar</text>
  </string>
  <string id="ui_mcm_aa_dia_guitar_enabled_desc">
    <text>Campfire guitar. Needs a guitar animation mod; off with none installed.</text>
  </string>
  <string id="ui_mcm_aa_dia_guitar_vol">
    <text>Guitar volume</text>
  </string>
  <string id="ui_mcm_aa_dia_guitar_vol_desc">
    <text>Volume of campfire guitar.</text>
  </string>

  <string id="ui_mcm_aa_hdr_dia_harmonica">
    <text>Harmonica</text>
  </string>
  <string id="ui_mcm_aa_dia_harmonica_enabled">
    <text>Enable harmonica</text>
  </string>
  <string id="ui_mcm_aa_dia_harmonica_enabled_desc">
    <text>Campfire harmonica. Needs a harmonica animation mod; off with none installed.</text>
  </string>
  <string id="ui_mcm_aa_dia_harmonica_vol">
    <text>Harmonica volume</text>
  </string>
  <string id="ui_mcm_aa_dia_harmonica_vol_desc">
    <text>Volume of campfire harmonica.</text>
  </string>
  <string id="ui_mcm_aa_development_btn_reset_all">
    <text>Reset to defaults</text>
  </string>
  <string id="ui_mcm_aa_development_btn_reset_all_desc">
    <text>Restore all AlifeAmbience MCM settings to defaults. Use after upgrading from a version with a different MCM structure.</text>
  </string>
  <string id="ui_mcm_aa_development_reset_warning">
    <text>Warning: save or discard pending MCM changes first, otherwise they override the reset on the next Accept.</text>
  </string>
  <string id="st_aa_reset_all_done">
    <text>AlifeAmbience: all settings restored to defaults.</text>
  </string>
  <string id="ui_mcm_aa_title">
    <text>AlifeAmbience</text>
  </string>
</string_table>
