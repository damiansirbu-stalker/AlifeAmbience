--- aa_diegetic: AlifeAmbience diegetic (in-world) audio control. The Diegetic MCM tab.
--- Controls volume/enable/frequency of in-world emitters the characters hear: base radios,
--- megaphones, and campfire instruments. Rehomed from the standalone Diegetic Audio Control
--- and rewritten against xray/anomaly source (see todo n080).
---
--- Two owned seams:
---   RADIO / MEGAPHONE - wrap ph_sound.snd_source.update (core, present on vanilla and the
---     Anomaly Radio Extended override). We call the original, then set the played sound's
---     volume to base * mult, where base is the section condlist volume - NOT the value we
---     last wrote. The old code read back played_sound.volume and multiplied it every frame;
---     since ph_sound only resets volume on its 50ms throttle but the binder updates per frame
---     (bind_physic_object.script:45-55), that compounded into an audible flutter. Computing
---     from the condlist base each time is stable.
---   INSTRUMENTS - replace guitar_anim.play_guitar / harmonica_anim.play_harmonica. The upstream
---     bakes volume into a local no-feedback play with no seam (guitar_anim.script:45-50), so the
---     replace is forced; but guitar and harmonica are the same shape, so one helper + a per-
---     instrument table carries the only differences (track count, path, motions, speed).
---
--- Neutral is pass-through: a source at mult 1.0 and enabled is left to vanilla untouched, and
--- with no MCM the config reads its neutral defaults, so the mod runs on any Anomaly, content-only.

local math_random, tonumber, tostring = math.random, tonumber, tostring
local sound_object, RegisterScriptCallback = sound_object, RegisterScriptCallback

-- Config snapshot, refreshed on option change. Initialized neutral so the hot path never
-- indexes a nil config (the missing guard in the old code) and a fresh install is pass-through.
local snap = {
    master = 1.0,
    radio_on = true, radio_vol = 1.0, radio_freq = 1.0,
    mega_on = true, mega_vol = 1.0, mega_freq = 1.0,
    guitar_on = true, guitar_vol = 1.0,
    harmonica_on = true, harmonica_vol = 1.0,
}

local function refresh()
    local getter = aa_mcm and aa_mcm.get_config
    local function get(key, default)
        local v = getter and getter(key)
        if v == nil then return default end
        return v
    end
    snap.master        = get("dia_master", 1.0)
    snap.radio_on      = get("dia_radio_enabled", true)
    snap.radio_vol     = get("dia_radio_vol", 1.0)
    snap.radio_freq    = get("dia_radio_freq", 1.0)
    snap.mega_on       = get("dia_megaphone_enabled", true)
    snap.mega_vol      = get("dia_megaphone_vol", 1.0)
    snap.mega_freq     = get("dia_megaphone_freq", 1.0)
    snap.guitar_on     = get("dia_guitar_enabled", true)
    snap.guitar_vol    = get("dia_guitar_vol", 1.0)
    snap.harmonica_on  = get("dia_harmonica_enabled", true)
    snap.harmonica_vol = get("dia_harmonica_vol", 1.0)
end

-- Classify a ph_sound emitter by its theme name. All live vanilla ph_sound are radios (the
-- "radio" substring covers the *_radio convention); megaphone is kept for sources that use a
-- ph_sound megaphone theme (none in vanilla - the real loudspeakers are play_sound schemes).
local function is_radio(theme)
    return theme:find("radio") or theme:find("sidor") or theme:find("forester") or theme:find("bar_")
        or theme:find("stalker_base") or theme:find("yantar") or theme:find("monolith")
        or theme:find("hangar") or theme:find("cit_mers") or theme:find("val_free")
        or theme:find("clear_sky") or theme:find("bandit")
end

local function is_megaphone(theme)
    return theme:find("megafon") or theme:find("megaphone") or theme:find("rupor")
        or theme:find("arena_") or theme:find("propaganda") or theme:find("alarm") or theme:find("announce")
end

local function classify(theme_name)
    if not theme_name then return "other" end
    local theme = theme_name:lower()
    if is_radio(theme) then return "radio" end
    if is_megaphone(theme) then return "megaphone" end
    return "other"
end

-- (volume mult, frequency/pause mult) for a category from the current snapshot. Disabled = 0 volume.
local function settings_for(cat)
    if cat == "radio" then
        return (snap.radio_on and snap.master * snap.radio_vol or 0), snap.radio_freq
    elseif cat == "megaphone" then
        return (snap.mega_on and snap.master * snap.mega_vol or 0), snap.mega_freq
    end
    return snap.master, 1.0
end

-- ph_sound.snd_source.update wrap ------------------------------------------------------------
local orig_snd_update = nil

local function hooked_snd_update(self, delta)
    local st = self.st
    local cat = st._dia_cat
    if cat == nil then
        cat = classify(st.theme)
        st._dia_cat = cat
        if aa_debug.on() then aa_debug.dbg("dia source theme=%s cat=%s", tostring(st.theme), cat) end
    end
    local vol_mult, freq_mult = settings_for(cat)

    -- Frequency: reconcile pause from the cached original every tick once touched, so returning
    -- the knob to 1.0 restores the original pause (the old code never restored at 1.0).
    if freq_mult ~= 1.0 or st._dia_pmin ~= nil then
        if st._dia_pmin == nil then
            st._dia_pmin = st.pause_min
            st._dia_pmax = st.pause_max
        end
        st.pause_min = st._dia_pmin * freq_mult
        st.pause_max = st._dia_pmax * freq_mult
    end

    orig_snd_update(self, delta)

    -- Volume: override only when not neutral, computed from the section condlist BASE (never the
    -- value we last wrote), so it cannot compound frame to frame.
    if vol_mult ~= 1.0 and self.played_sound and self.played_sound:playing() then
        local base = 1.0
        if st.volume then
            local picked = xr_logic.pick_section_from_condlist(db.actor, self.object, st.volume)
            if picked and picked ~= "" then base = tonumber(picked) or 1.0 end
        end
        self.played_sound.volume = base * vol_mult
        if aa_debug.on() then
            aa_debug.dbg("dia %s '%s' base=%.2f mult=%.2f -> %.2f",
                cat, tostring(st.theme), base, vol_mult, base * vol_mult)
        end
    end
end

-- Instruments --------------------------------------------------------------------------------
-- One play helper. The table carries the only per-instrument differences; the upstream holster
-- for both is holster_guitar (harmonica_anim.script:63, an upstream naming quirk, not a bug).
local INSTR = {
    guitar = {
        mod = nil, tracks = 28, path = "music\\guitar_",
        motion_item = "item_guit_anm_1_hud", motion_show = "anm_guitar_show", show_speed = 1,
        on = function() return snap.guitar_on end, vol = function() return snap.guitar_vol end,
    },
    harmonica = {
        mod = nil, tracks = 5, path = "music\\harmonica_",
        motion_item = "item_harm_anm_1_hud", motion_show = "anm_harmonica_show", show_speed = 0.45,
        on = function() return snap.harmonica_on end, vol = function() return snap.harmonica_vol end,
    },
}

local function play_instrument(name)
    local instr = INSTR[name]
    local mod = instr.mod
    if not instr.on() then
        if mod.restore then mod.restore() end
        return
    end

    level.disable_input()
    local snd = sound_object(instr.path .. math_random(instr.tracks))
    local len = snd:length() / 1000
    snd:play_no_feedback(db.actor, 0, 0, db.actor:position(), snap.master * instr.vol(), 1.0)
    game.play_hud_motion(2, instr.motion_item, instr.motion_show, false, instr.show_speed)

    CreateTimeEvent(name .. "_holster_a", name .. "_holster_v", len, function()
        if mod.can_play_anim() then
            mod.holster_guitar()
            return true
        end
        return false
    end)
end

-- Install ------------------------------------------------------------------------------------
local function install_hooks()
    if ph_sound and ph_sound.snd_source and ph_sound.snd_source.update then
        orig_snd_update = ph_sound.snd_source.update
        ph_sound.snd_source.update = hooked_snd_update
        aa_debug.dbg("diegetic: hooked ph_sound.snd_source.update (radio/megaphone)")
    else
        aa_debug.warn("diegetic: ph_sound absent - radio/megaphone control off")
    end

    if guitar_anim and guitar_anim.play_guitar then
        INSTR.guitar.mod = guitar_anim
        guitar_anim.play_guitar = function() play_instrument("guitar") end
    end
    if harmonica_anim and harmonica_anim.play_harmonica then
        INSTR.harmonica.mod = harmonica_anim
        harmonica_anim.play_harmonica = function() play_instrument("harmonica") end
    end
end

function on_game_start()
    refresh()
    install_hooks()
    RegisterScriptCallback("actor_on_first_update",      refresh)
    RegisterScriptCallback("on_option_change",           refresh)
    RegisterScriptCallback("mcm_option_restore_default", refresh)
end
