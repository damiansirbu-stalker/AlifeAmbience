--- as_mcm: MCM config for AlifeSpooks. Two tabs (Atmosphere, Development), mirrors at_mcm.

as_mcm = as_mcm or {}

if not xmcm then
    as_mcm.get_config = function() return nil end
    return
end

local defaults = {
    vol_global = 1.0,
    vol_spooks = 1.0, vol_screams = 1.0, vol_mutants = 1.0, vol_ambience = 1.0,
    vol_machines = 1.0, vol_forest = 1.0, vol_storm = 1.0, vol_wind = 1.0,
    vol_rain = 1.0, vol_wildlife = 1.0, vol_underground = 1.0,
    rarity = 1.0, distance = 1.0, loop_volume = 0.55, variety = true,
    log_level = "WARN", log_flush = false,
}

local _key_to_tab = {
    vol_global = "atmosphere", vol_spooks = "atmosphere", vol_screams = "atmosphere",
    vol_mutants = "atmosphere", vol_ambience = "atmosphere", vol_machines = "atmosphere",
    vol_forest = "atmosphere", vol_storm = "atmosphere", vol_wind = "atmosphere",
    vol_rain = "atmosphere", vol_wildlife = "atmosphere", vol_underground = "atmosphere",
    rarity = "atmosphere", distance = "atmosphere", loop_volume = "atmosphere",
    variety = "atmosphere", log_level = "development", log_flush = "development",
    btn_reset_all = "development",
}

local function path_builder(key)
    return "as/" .. (_key_to_tab[key] or "atmosphere") .. "/" .. key
end

cfg, get_config, load_config = xmcm.create_config("as", defaults, path_builder)
as_mcm.get_config = get_config

--- Write every default to storage, save, reload, notify consumers, close the menu
local function _apply_defaults(gui, msg)
    local config = axr_main.config
    for k, v in pairs(defaults) do
        config:w_value("mcm", path_builder(k), v)
    end
    config:save()
    load_config()
    SendScriptCallback("mcm_option_restore_default")
    if gui then
        if gui.owner and gui.owner.SetMsg then gui.owner:SetMsg(msg, 5) end
        if gui.On_Cancel then gui:On_Cancel() end
    end
    if db.actor then
        news_manager.send_tip(db.actor, msg, nil, nil, 5000)
    end
end

function btn_reset_all(gui)
    _apply_defaults(gui, game.translate_string("st_as_reset_all_done"))
end

local GREY = {255, 200, 200, 200}
local function vol_track(id)
    return { id = id, type = "track", val = 2, min = 0.0, max = 5.0, step = 0.05, def = 1.0, hint = "as_" .. id }
end

--- Atmosphere tab: per-layer volume, rarity, distance, loop volume, variety
local function atmosphere_page()
    return {
        id = "atmosphere", sh = true,
        gr = {
            { id = "title", type = "slide", link = "as_mcm_banner",
                text = "ui_mcm_as_title", size = {512, 50}, spacing = 20 },
            { id = "desc", type = "desc", text = "ui_mcm_as_desc" },
            { id = "vol_global", type = "track", val = 2, min = 0.0, max = 5.0, step = 0.05, def = 1.0, hint = "as_vol_global" },

            { id = "div_layers", type = "line" },
            { id = "hdr_layers", type = "desc", text = "ui_mcm_as_hdr_layers", clr = GREY },
            vol_track("vol_spooks"),
            vol_track("vol_screams"),
            vol_track("vol_mutants"),
            vol_track("vol_ambience"),
            vol_track("vol_machines"),
            vol_track("vol_forest"),
            vol_track("vol_storm"),
            vol_track("vol_wind"),
            vol_track("vol_rain"),
            vol_track("vol_wildlife"),
            vol_track("vol_underground"),

            { id = "div_feel", type = "line" },
            { id = "hdr_feel", type = "desc", text = "ui_mcm_as_hdr_feel", clr = GREY },
            { id = "rarity",   type = "track", val = 2, min = 0.5, max = 3.0, step = 0.05, def = 1.0, hint = "as_rarity" },
            { id = "distance", type = "track", val = 2, min = 0.5, max = 2.0, step = 0.05, def = 1.0, hint = "as_distance" },
            { id = "loop_volume", type = "track", val = 2, min = 0.0, max = 2.0, step = 0.05, def = 0.55, hint = "as_loop_volume" },
            { id = "variety", type = "check", val = 1, def = true, hint = "as_variety" },
        },
    }
end

--- Development tab: trace log level, flush, reset-to-defaults
local function development_page()
    return {
        id = "development", sh = true,
        gr = {
            { id = "title", type = "slide", link = "as_mcm_banner",
                text = "ui_mcm_as_title", size = {512, 50}, spacing = 20 },
            { id = "dev_desc", type = "desc", text = "ui_mcm_as_development_desc" },
            { id = "div_logging", type = "line" },
            { id = "hdr_logging", type = "desc", text = "ui_mcm_as_hdr_logging", clr = GREY },
            { id = "log_level", type = "list", val = 0, def = "WARN", hint = "as_log_level", content = {
                {"ERROR", "error"}, {"WARN", "warn"}, {"INFO", "info"}, {"DEBUG", "debug"},
              } },
            { id = "log_flush", type = "check", val = 1, def = false, hint = "as_log_flush" },

            { id = "div_reset", type = "line" },
            { id = "warn_reset", type = "desc", text = "ui_mcm_as_development_reset_warning", clr = {255, 240, 200, 80} },
            { id = "btn_reset_all", type = "button", functor_ui = { btn_reset_all } },
        },
    }
end

function on_mcm_load()
    return {
        id = "as",
        gr = {
            atmosphere_page(),
            development_page(),
        },
    }
end
