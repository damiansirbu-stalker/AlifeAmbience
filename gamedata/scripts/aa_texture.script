-- aa_texture.script - AlifeAmbience continuous texture layer.
--
-- Plays ONE looped dark bed matched to the player's context (underground /
-- weather / outdoor), quiet, under everything. On a context change it crossfades:
-- the old bed fades out while the new one fades in, so no seam and no pile-up.
-- This is the update_wind pattern (sound_ambient.script:180-237), one bed at a
-- time. It never touches the engine's own background bed, and it uses no
-- update_ambient hook - looped sounds carry native volume (set_volume_sound_looped).
--
-- Beds and their loop themes are data: configs/scripts/aa_texture_beds.ltx, e.g.
--   [dread]
--   themes = aa_tex_dread_1, aa_tex_dream_2, ...
-- Each theme is a [name]/type=looped/path=... sound_theme (mod_script_sound_aa.ltx),
-- both generated by tools/merge.py from texture_beds.json. This script only drives
-- them. If the config is absent it no-ops - safe on a partial install.

local FADE_STEP   = 0.08   -- volume change per update tick (about 1s to fade)
local BASE_VOLUME = 0.55   -- default ceiling for the texture layer (quiet, under the mix)
local CFG         = "scripts\\aa_texture_beds.ltx"

-- The texture ceiling, from MCM if xlibs+MCM are present, else the default. Guarded so
-- the texture player runs on any Anomaly with or without the control layer.
local function base_vol()
    return (aa_mcm and aa_mcm.get_config and aa_mcm.get_config("texture_volume")) or BASE_VOLUME
end

local _beds    = nil       -- { bedname = { theme, theme, ... } }
local _cur     = nil       -- currently playing { bed, theme, vol }
local _target  = nil       -- bed we want playing

local function load_beds()
    local ini = ini_file(CFG)
    if not ini then return nil end
    local t = {}
    if not ini:section_exist("beds") then return nil end
    for i = 0, (ini:line_count("beds") or 1) - 1 do
        local _, name = ini:r_line("beds", i, "", "")
        if name and name ~= "" and ini:section_exist(name) then
            t[name] = parse_list(ini, name, "themes")
        end
    end
    return next(t) and t or nil
end

-- The X-Lab levels (level.name() values, from the game's own ambient configs).
-- Underground on these draws the LAB texture pool (machine, metal, voices, banging);
-- every other underground place draws the SEWER pool (drip, rats, ambient, drone).
local LAB_LEVELS = {
    l04u_labx18 = true, l08u_brainlab = true, l13u_warlab = true,
    labx8 = true, l12u_control_monolith = true, l12u_sarcofag = true,
}

-- Which bed the current context wants. One bed, priority: underground > weather >
-- time-of-day. Underground (via the engine's "underground" event) splits lab vs
-- sewer by the current level; weather gates storm/rain and fog; on clear surface
-- the bed follows the hour - the dread drone-bed after dusk, the lighter wind-bed
-- by day (level.get_time_hours, level_weathers.script:556).
local function want_bed()
    if GetEvent and GetEvent("underground") then
        local lvl = level.name and level.name() or ""
        return LAB_LEVELS[lvl] and "underground_lab" or "underground_sewer"
    end
    local w = level.get_weather and level.get_weather() or ""
    local rain = level.rain_factor and level.rain_factor() or 0
    if w:find("storm") or rain > 0.3 then return "stormrain" end
    if w:find("foggy") or w:find("tuman") then return "fog" end
    if rain > 0.05 then return "stormrain" end
    local hr = level.get_time_hours and level.get_time_hours() or 12
    if hr >= 20 or hr < 6 then return "dread" end   -- dusk-to-dawn: heavier
    return "wind"                                   -- daylight surface: lighter
end

local function pick_theme(bed)
    local list = _beds and _beds[bed]
    if not list or #list == 0 then return nil end
    return list[math.random(#list)]
end

local function actor_id() return db.actor and db.actor:id() or 0 end

-- Fade the current bed toward its target volume; when a new bed is requested,
-- fade the old one out first, then swap and fade the new one in.
local function tick()
    if not _beds then return end
    local id = actor_id()
    _target = want_bed()

    if _cur and _cur.bed ~= _target then
        -- fade the outgoing bed down; swap once silent
        _cur.vol = _cur.vol - FADE_STEP
        if _cur.vol <= 0 then
            xr_sound.stop_sound_looped(id, _cur.theme)
            _cur = nil
        else
            xr_sound.set_volume_sound_looped(id, _cur.theme, _cur.vol)
        end
        return
    end

    if not _cur then
        local theme = pick_theme(_target)
        if not theme then return end
        xr_sound.play_sound_looped(id, theme)
        _cur = { bed = _target, theme = theme, vol = 0 }
    end

    local ceil = base_vol()
    if _cur.vol < ceil then                         -- fade the current bed in
        _cur.vol = math.min(ceil, _cur.vol + FADE_STEP)
        xr_sound.set_volume_sound_looped(id, _cur.theme, _cur.vol)
    end
end

local function on_first_update()
    _beds = load_beds()
    if not _beds then return end                    -- no config -> inert
    CreateTimeEvent("aa_texture", "tick", 1, function()
        ResetTimeEvent("aa_texture", "tick", 1)
        tick()
        return false
    end)
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update", on_first_update)
end
