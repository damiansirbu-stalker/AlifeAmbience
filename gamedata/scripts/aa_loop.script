--- aa_loop: AlifeAmbience continuous loop layer. One looped dark bed per context, crossfaded.

local ini_file, parse_list, next, pairs = ini_file, parse_list, next, pairs
local math_random, math_min = math.random, math.min
local GetEvent, RegisterScriptCallback = GetEvent, RegisterScriptCallback

local FADE_STEP    = 0.08
local BASE_VOLUME  = 0.55
local CFG          = "scripts\\aa_loop_beds.ltx"
local SECTION_BEDS = "beds"

--- Loop ceiling from MCM, or the default
local function base_vol()
    return (aa_mcm and aa_mcm.get_config and aa_mcm.get_config("loop_volume")) or BASE_VOLUME
end

local _beds   = nil
local _cur    = nil
local _target = nil

--- Load { bed = { theme, ... } } from aa_loop_beds.ltx, or nil if absent
local function load_beds()
    local ini = ini_file(CFG)
    if not ini then return nil end
    if not ini:section_exist(SECTION_BEDS) then return nil end
    local beds = {}
    for i = 0, (ini:line_count(SECTION_BEDS) or 1) - 1 do
        local _, name = ini:r_line(SECTION_BEDS, i, "", "")
        if name and name ~= "" and ini:section_exist(name) then
            beds[name] = parse_list(ini, name, "themes")
        end
    end
    return next(beds) and beds or nil
end

local LAB_LEVELS = {
    l04u_labx18 = true, l08u_brainlab = true, l13u_warlab = true,
    labx8 = true, l12u_control_monolith = true, l12u_sarcofag = true,
}

--- The bed the current context wants: underground > weather > time-of-day
local function want_bed()
    if GetEvent and GetEvent("underground") then
        local level_name = level.name and level.name() or ""
        if LAB_LEVELS[level_name] then return "underground_lab" end
        return "underground_sewer"
    end
    local weather = level.get_weather and level.get_weather() or ""
    local rain = level.rain_factor and level.rain_factor() or 0
    if weather:find("storm") or rain > 0.3 then return "stormrain" end
    if weather:find("foggy") or weather:find("tuman") then return "fog" end
    if rain > 0.05 then return "stormrain" end
    local hour = 12
    if level.present() then hour = level.get_time_hours() end
    if hour >= 20 or hour < 6 then return "dread" end
    return "wind"
end

local function pick_theme(bed)
    local list = _beds and _beds[bed]
    if not list or #list == 0 then return nil end
    return list[math_random(#list)]
end

local function actor_id() return db.actor and db.actor:id() or 0 end

--- Trace a bed change with the player location
local function trace_bed(bed, theme)
    if not (aa_debug and aa_debug.on and aa_debug.on()) then return end
    local pos = db.actor and db.actor:position()
    aa_debug.dbg("loop bed=%s theme=%s lvl=%s pos=%.0f,%.0f,%.0f", bed, theme,
        (level.name and level.name()) or "?",
        pos and pos.x or 0, pos and pos.y or 0, pos and pos.z or 0)
end

--- Fade toward the target bed; on a bed change, fade the old one out then swap
local function update_bed()
    if not _beds then return end
    local actor = actor_id()
    _target = want_bed()

    if _cur and _cur.bed ~= _target then
        _cur.vol = _cur.vol - FADE_STEP
        if _cur.vol <= 0 then
            xr_sound.stop_sound_looped(actor, _cur.theme)
            _cur = nil
        else
            xr_sound.set_volume_sound_looped(actor, _cur.theme, _cur.vol)
        end
        return
    end

    if not _cur then
        local theme = pick_theme(_target)
        if not theme then return end
        xr_sound.play_sound_looped(actor, theme)
        _cur = { bed = _target, theme = theme, vol = 0 }
        trace_bed(_target, theme)
    end

    local ceiling = base_vol()
    if _cur.vol < ceiling then
        _cur.vol = math_min(ceiling, _cur.vol + FADE_STEP)
        xr_sound.set_volume_sound_looped(actor, _cur.theme, _cur.vol)
    end
end

local function on_first_update()
    _beds = load_beds()
    if not _beds then
        if aa_debug and aa_debug.warn then
            aa_debug.warn("loop: no beds (scripts\\aa_loop_beds.ltx missing/empty) - loop layer inert")
        end
        return
    end
    if aa_debug and aa_debug.on and aa_debug.on() then
        local count = 0
        for _ in pairs(_beds) do count = count + 1 end
        aa_debug.dbg("loop: %d beds loaded", count)
    end
    CreateTimeEvent("aa_loop", "update", 1, function()
        ResetTimeEvent("aa_loop", "update", 1)
        update_bed()
        return false
    end)
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update", on_first_update)
end
