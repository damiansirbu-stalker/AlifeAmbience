--- aa_sound: AlifeAmbience runtime control + trace for the dynamic accent layer.
---
--- The engine's dynamic ambient one-shots are played by vanilla sound_ambient.update_ambient,
--- a CreateTimeEvent action re-armed once per second (sound_ambient.script:86, :270). That
--- function computes each play's channel, file, distance and volume from FILE-LOCAL state
--- (snd_chanels/next_idx/opt) that no other script can read, and it exposes no callback. So to
--- trace it - or to tune it per mood - the only Lua path is to OWN the event slot: the queue
--- dispatches by stored function value (_g.script:374) and CreateTimeEvent only fills an EMPTY
--- slot (:345), so a reassignment is dead and a bare re-add is a no-op; RemoveTimeEvent then
--- CreateTimeEvent installs ours. We keep a faithful clone of update_ambient + reset_settings
--- (own state, public API only) and insert trace + the per-mood volume/rarity/distance knobs at
--- the vanilla injection points. GAMMA runs the vanilla script unmodified (verified), so this
--- clone matches what ships.
---
--- Neutral is pass-through (I14): with tracing off and every knob at 1.0 we do not own the slot
--- at all - vanilla runs untouched, zero cost. We take ownership only while a feature is active,
--- and hand it back (priming vanilla's state first) when all features return to neutral. This is
--- the at_world_trace refresh-on-option-change pattern.

local math_random, math_rad, math_cos, math_sin = math.random, math.rad, math.cos, math.sin
local table_remove = table.remove
local ini_file, parse_list, time_global = ini_file, parse_list, time_global
local GetEvent, sound_object, vector = GetEvent, sound_object, vector
local RegisterScriptCallback = RegisterScriptCallback

-- The layers = the pure-purpose channel groups. Each dynamic channel maps to one
-- layer via aa_channel_layers.ltx (generated by merge.py, mood_of the single source);
-- the layer picks the MCM volume knob. Base channels the mod enriches are in the map too.
local LAYERS = { "spooks", "screams", "mutants", "ambience", "machines",
                 "forest", "storm", "wind", "rain", "wildlife", "underground" }

-- Our own copy of the dynamic-layer state (we cannot read vanilla's file-locals).
local snd_chanels = {}
local tot_size = 0
local next_idx = 0
local last_hour = nil
-- current ambient section (time+weather), carried into the accent trace line
local last_ambient = nil
-- current level; reset when it changes so channels never carry across a level load
local last_level = nil
local opt_ambient_volume = 1

-- Snapshot of the knobs, refreshed from MCM. Neutral = pass-through.
local vol = { global = 1, spooks = 1, screams = 1, mutants = 1, ambience = 1, machines = 1,
              forest = 1, storm = 1, wind = 1, rain = 1, wildlife = 1, underground = 1 }
-- multiplies the reschedule period (higher = rarer)
local rarity = 1
-- multiplies the computed spawn radius
local distance = 1
-- no-repeat variety: never replay a channel's recent sound (default on)
local variety = true

-- A period of 0 (or missing) would make ch.next = tg + 0 fire every tick; floor it. 0 is
-- truthy in Lua so a plain `or` does not catch it - test > 0 explicitly.
local function _period(v)
    return (v and v > 0) and v or 20000
end

-- ---------------------------------------------------------------------------
-- Faithful clone of sound_ambient.reset_settings (:24-71), writing OUR state.
-- ---------------------------------------------------------------------------
local function reset_settings(level_name, ambient)
    snd_chanels = {}
    if not (level_name and ambient and ambient ~= "") then return false end
    local ini_lvl = ini_file("environment\\ambients\\" .. level_name .. ".ltx")
    if not ini_lvl then return false end
    local channels = parse_list(ini_lvl, ambient, "sound_channels_dynamic")
    if #channels == 0 then return false end
    local cached = {}
    local ini_snd = ini_file("environment\\sound_channels.ltx")
    local ini_lay = ini_file("environment\\aa_channel_layers.ltx")
    for i = 1, #channels do
        local ch = channels[i]
        -- skip a channel already taken, absent, or with no resolvable sounds (an empty list
        -- would crash the play). Computing sounds here keeps the guard at one nesting level.
        local sounds = (not cached[ch]) and ini_snd:section_exist(ch) and parse_list(ini_snd, ch, "sounds")
        if sounds and #sounds > 0 then
            cached[ch] = true
            local entry = {}
            entry.name = ch
            entry.max_dist = ini_snd:r_float_ex(ch, "max_distance") or 80
            entry.min_dist = ini_snd:r_float_ex(ch, "min_distance") or 45
            entry.height = ini_snd:r_float_ex(ch, "height") or 0
            entry.indoor = ini_snd:r_bool_ex(ch, "indoor") or false
            -- default a missing/zero period so ch.next = tg + period never adds nil (the vanilla
            -- period-nil trap, ambient-sound-system.md:365) nor fires every tick.
            entry.periods = { _period(ini_snd:r_float_ex(ch, "period0")), _period(ini_snd:r_float_ex(ch, "period1")),
                              _period(ini_snd:r_float_ex(ch, "period2")), _period(ini_snd:r_float_ex(ch, "period3")) }
            entry.sounds = sounds
            -- layer (which MCM volume knob) comes from the generated channel->layer map,
            -- not the name: any channel we place or enrich is listed there.
            entry.layer = ini_lay and ini_lay:r_string_ex("aa_channel_layers", ch)
            snd_chanels[#snd_chanels + 1] = entry
        end
    end
    tot_size = #snd_chanels
    return true
end

-- ---------------------------------------------------------------------------
-- No-repeat variety: never replay a channel's recent sound, so a rich channel's
-- variety is actually heard (never the same call twice back to back) and a thin one
-- does not stutter. Per-channel ring of the last few indices; re-roll until fresh.
-- With variety off, or a one-sound channel, it is plain vanilla random.
-- ---------------------------------------------------------------------------
local NO_REPEAT = 8
local function pick_sound(ch)
    local count = #ch.sounds
    if count <= 1 then return ch.sounds[1] end
    if not variety then return ch.sounds[math_random(count)] end
    local avoid = (NO_REPEAT < count) and NO_REPEAT or (count - 1)
    local seen, ring = ch.seen, ch.ring
    if not seen then seen = {}; ring = {}; ch.seen = seen; ch.ring = ring end
    local idx
    repeat idx = math_random(count) until not seen[idx]
    seen[idx] = true
    ring[#ring + 1] = idx
    if #ring > avoid then
        seen[table_remove(ring, 1)] = nil
    end
    return ch.sounds[idx]
end

-- ---------------------------------------------------------------------------
-- Spawn one channel's sound around the actor (the play block of update_ambient,
-- :96-128), applying the distance/volume/rarity knobs and the trace.
-- ---------------------------------------------------------------------------
local function play_channel(ch, tg)
    local actor = db.actor
    -- no actor during a load window: skip this tick, the round-robin retries next second
    if not actor then return end
    local inside = GetEvent("current_safe_cover")
    local underground = GetEvent("underground")
    local pos = actor:position()
    local max_dist = ch.max_dist
    local min_dist = underground and ch.min_dist or ((max_dist + ch.min_dist) / 2)
    -- malformed source distances would give lo > hi; math_random requires lo <= hi
    if min_dist > max_dist then min_dist = max_dist end
    -- KNOB: distance multiplies the spawn radius
    local dist = (math_random(min_dist, max_dist) / 2) * distance
    local angle_rad = math_rad(math_random(0, 359))
    local vec = vector():set(pos.x + math_cos(angle_rad) * dist, pos.y + ch.height,
                             pos.z + math_sin(angle_rad) * dist)

    local file = pick_sound(ch)
    ch.snd = sound_object(file)
    ch.snd:play_at_pos(actor, vec)

    local level_vol
    if underground or inside then
        level_vol = ch.indoor and 1 or 0.3
    else
        level_vol = ch.indoor and 0 or 1
    end
    -- KNOB: per-layer volume (falls back to the global knob for an unmapped channel)
    level_vol = level_vol * opt_ambient_volume * (ch.layer and vol[ch.layer] or vol.global)
    ch.snd.volume = level_vol

    -- KNOB: rarity multiplies the reschedule period
    ch.next = tg + (ch.periods[math_random(4)]) * rarity

    if aa_debug.on() then
        -- log WHERE the player is (level, position, hour, weather/section) so a played sound
        -- can be assessed against the actor's actual location, plus how far it spawned.
        aa_debug.dbg("accent lvl=%s pos=%.0f,%.0f,%.0f hour=%s amb=%s ch=%s layer=%s file=%s dist=%.1f vol=%.2f ug=%s inside=%s",
            aa_debug.show(level.name()), pos.x, pos.y, pos.z, aa_debug.show(last_hour),
            aa_debug.show(last_ambient), ch.name, aa_debug.show(ch.layer), file, dist, level_vol,
            aa_debug.show(underground), aa_debug.show(inside))
    end
end

-- ---------------------------------------------------------------------------
-- Faithful clone of sound_ambient.update_ambient (:86-178) + trace + knobs.
-- ---------------------------------------------------------------------------
local function update_ambient_owned()
    ResetTimeEvent("sound_channels", "update_ambient", 1)

    if not level.present() then return false end
    local next_hour = level.get_time_hours()
    local next_level = level.name()
    local wm = level_weathers.get_weather_manager()
    local ambient = wm and wm:get_curr_ambient()
    -- Reset on ANY context change - hour, LEVEL, or ambient (weather+time) - so a channel
    -- scheduled on one context never fires under another. Vanilla resets on hour only, which
    -- leaves the old level's channels loaded after a same-hour level load; this is stricter.
    -- get_curr_ambient is cached per (hour, weather) so the per-tick compare is cheap.
    if next_hour ~= last_hour or next_level ~= last_level or ambient ~= last_ambient then
        last_hour = next_hour
        last_level = next_level
        last_ambient = ambient
        next_idx = 0
        -- NEVER self-remove: _apply_owned is the sole owner of this slot. A section with no
        -- channels just leaves snd_chanels empty and we tick harmlessly until the next context
        -- change re-loads it. (Vanilla returns true here to self-remove, which for us would
        -- silently stop the layer and never come back, since we do not re-create on our own.)
        reset_settings(next_level, ambient)
        return false
    end

    next_idx = next_idx + 1
    if next_idx > tot_size then next_idx = 1 end

    local tg = time_global()
    local ch = snd_chanels[next_idx]
    if not ch then return false end
    if not ch.next then
        ch.next = tg + math_random(1, (ch.periods[math_random(4)] + 1))
        return false
    end

    if ch.next <= tg then
        play_channel(ch, tg)
    end

    return false
end

-- ---------------------------------------------------------------------------
-- Ownership: own the slot only while a feature is active (I14 pass-through).
-- ---------------------------------------------------------------------------
local _owned = false

local function _feature_active()
    if aa_debug.on() then return true end
    if variety then return true end
    if rarity ~= 1 or distance ~= 1 or vol.global ~= 1 then return true end
    for i = 1, #LAYERS do if vol[LAYERS[i]] ~= 1 then return true end end
    return false
end

local function _apply_owned()
    local want = _feature_active()
    if want == _owned then return end
    _owned = want
    if _owned then
        -- take the slot: robust to whether vanilla has registered yet (CreateTimeEvent
        -- only fills an empty slot, so if vanilla registers later it no-ops onto ours).
        RemoveTimeEvent("sound_channels", "update_ambient")
        CreateTimeEvent("sound_channels", "update_ambient", 1, update_ambient_owned)
        -- force a fresh reset on our first tick (any context var nil -> reset fires)
        last_hour = nil
        last_level = nil
        last_ambient = nil
        next_idx = 0
        aa_debug.info("aa_sound: owning update_ambient (a control feature is active)")
    else
        -- hand back to vanilla; prime its file-local state so it cannot tick on an
        -- empty table (sound_ambient.reset_settings writes vanilla's own snd_chanels).
        -- Guarded on db.actor: on_option_change can fire from the MCM menu with no level.
        if db.actor then
            local wm = level_weathers.get_weather_manager()
            local ambient = wm and wm:get_curr_ambient()
            if ambient then sound_ambient.reset_settings(level.name(), ambient) end
        end
        RemoveTimeEvent("sound_channels", "update_ambient")
        CreateTimeEvent("sound_channels", "update_ambient", 1, sound_ambient.update_ambient)
        aa_debug.info("aa_sound: released update_ambient back to vanilla (neutral)")
    end
end

local function refresh()
    vol.global = aa_mcm.get_config("vol_global") or 1
    for i = 1, #LAYERS do vol[LAYERS[i]] = aa_mcm.get_config("vol_" .. LAYERS[i]) or 1 end
    rarity = aa_mcm.get_config("rarity") or 1
    distance = aa_mcm.get_config("distance") or 1
    variety = aa_mcm.get_config("variety") ~= false
    opt_ambient_volume = (ui_options and ui_options.get("sound/environment/ambient_volume")) or 1
    _apply_owned()
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update",      refresh)
    RegisterScriptCallback("on_option_change",           refresh)
    RegisterScriptCallback("mcm_option_restore_default", refresh)
end
