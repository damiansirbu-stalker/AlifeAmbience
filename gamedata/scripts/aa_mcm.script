--- aa_mcm: MCM config for AlifeAmbience. Mirrors AlifeTactics at_mcm: a defaults table that
--- MIRRORS the on_mcm_load tree, a path_builder, and xmcm.create_config for the getter.
--- get_config(key) reads ui_mcm live with the defaults table as fallback (mcm.md snapshot note:
--- the control layer snapshots these on option change, so this is not a hot path).
---
--- One page. Control block: per-mood volume, rarity, distance for the accent layer (aa_sound),
--- and the texture-bed volume (aa_texture). Every control is 1.0 = pass-through, so a fresh
--- install is identical to vanilla until a knob is moved. Development block: the ambient-play
--- trace - set log level to DEBUG to record every accent the Zone plays to alifeambience.log.
--- Labels/hints live in configs/text/<lang>/ui_st_mcm_aa.xml (id ui_mcm_aa_<key> + _desc).

aa_mcm = aa_mcm or {}

-- Portability: the MCM page needs xlibs (xmcm). Without it, get_config returns nil so
-- every consumer falls back to its own default (neutral) - the mod runs content-only on
-- any Anomaly, no MCM page, no error.
if not xmcm then
    aa_mcm.get_config = function() return nil end
    return
end

local defaults = {
    vol_global = 1.0, vol_dread = 1.0, vol_underground = 1.0, vol_weather = 1.0,
    vol_human = 1.0, vol_animal = 1.0,
    rarity = 1.0, distance = 1.0, texture_volume = 0.55,
    log_level = "WARN", log_flush = false,
}

local function path_builder(key)
    return "aa/" .. key
end

cfg, get_config, load_config = xmcm.create_config("aa", defaults, path_builder)
aa_mcm.get_config = get_config

local GREY = {255, 200, 200, 200}
local function vol_track(id)
    return { id = id, type = "track", val = 2, min = 0.0, max = 5.0, step = 0.05, def = 1.0, hint = "aa_" .. id }
end

function on_mcm_load()
    return {
        id = "aa", sh = true,
        gr = {
            { id = "desc", type = "desc", text = "ui_mcm_aa_desc" },
            { id = "vol_global", type = "track", val = 2, min = 0.0, max = 5.0, step = 0.05, def = 1.0, hint = "aa_vol_global" },

            { id = "div_moods", type = "line" },
            { id = "hdr_moods", type = "desc", text = "ui_mcm_aa_hdr_moods", clr = GREY },
            vol_track("vol_dread"),
            vol_track("vol_underground"),
            vol_track("vol_weather"),
            vol_track("vol_human"),
            vol_track("vol_animal"),

            { id = "div_feel", type = "line" },
            { id = "hdr_feel", type = "desc", text = "ui_mcm_aa_hdr_feel", clr = GREY },
            { id = "rarity",   type = "track", val = 2, min = 0.5, max = 3.0, step = 0.05, def = 1.0, hint = "aa_rarity" },
            { id = "distance", type = "track", val = 2, min = 0.5, max = 2.0, step = 0.05, def = 1.0, hint = "aa_distance" },
            { id = "texture_volume", type = "track", val = 2, min = 0.0, max = 2.0, step = 0.05, def = 0.55, hint = "aa_texture_volume" },

            { id = "div_dev", type = "line" },
            { id = "hdr_dev", type = "desc", text = "ui_mcm_aa_hdr_dev", clr = GREY },
            { id = "log_level", type = "list", val = 0, def = "WARN", hint = "aa_log_level", content = {
                {"WARN", "off"}, {"INFO", "info"}, {"DEBUG", "debug"}, {"TRACE", "trace"},
              } },
            { id = "log_flush", type = "check", val = 1, def = false, hint = "aa_log_flush" },
        },
    }
end
